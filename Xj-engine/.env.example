# ETL Engine Standalone 环境变量示例
# 复制为 .env 或直接在环境中导出；生产环境必须填写真实值，禁止写死在代码/文档中。

# 数据目录（默认 ./data，一般无需修改）
# ETL_DATA_DIR=./data

# 独立 outbox 数据库（默认 ./data/etl_engine_outbox.db）
# ETL_OUTBOX_DB=./data/etl_engine_outbox.db

# RabbitMQ（middleware/etl_mq.py）
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/etl
RABBITMQ_USER=
RABBITMQ_PASS=

# Redis（middleware/etl_mq.py）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# MinIO（middleware/minio_ops.py）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=etl_user
MINIO_SECRET_KEY=
MINIO_SECURE=false

# 可选前缀/本地镜像目录
# ETL_MINIO_SOURCE_PREFIX=general_doc_source/
# ETL_MINIO_TMP_PREFIX=general_doc_tmp/
# ETL_MINIO_FALLBACK_LOCAL_DIR=data/general_doc_local
