{
  "gate": "dpm_section10",
  "desc": "DPM 交互文档第10节字段约束表存在性：缺此节 → 测试角色退回补充，禁止凭猜测编造边界（min/max 单元格空值语义校验留待批次2脚本化）",
  "checks": [
    {
      "type": "file_exists",
      "path": "{dpmdoc}",
      "label": "交互设计文档存在"
    },
    {
      "type": "grep_count",
      "pattern": "字段约束表",
      "path": "{dpmdoc}",
      "op": "min",
      "value": 1,
      "label": "第10节字段约束表存在"
    },
    {
      "type": "grep_count",
      "pattern": "min",
      "path": "{dpmdoc}",
      "op": "min",
      "value": 1,
      "label": "含 min 列"
    },
    {
      "type": "grep_count",
      "pattern": "max",
      "path": "{dpmdoc}",
      "op": "min",
      "value": 1,
      "label": "含 max 列"
    }
  ]
}
