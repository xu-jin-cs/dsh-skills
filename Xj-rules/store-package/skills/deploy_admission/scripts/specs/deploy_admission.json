{
  "gate": "deploy_admission",
  "desc": "部署启动准入（DEPLOY-001 重生版：交付物缺失阻塞部署）。A=三项全满足放行 Step1；B=拒绝启动，violations 即缺项清单。PM 指令项无法机械判，留软层由 sv-supervisor 终裁",
  "checks": [
    {
      "type": "file_exists",
      "path": "{frontend}",
      "label": "前端交付物存在（构建产物目录/文件）"
    },
    {
      "type": "file_exists",
      "path": "{backend}",
      "label": "后端交付物存在"
    },
    {
      "type": "file_exists",
      "path": "{report}",
      "label": "测试终判报告存在"
    },
    {
      "type": "json_field",
      "path": "{report}",
      "field": "summary.failed",
      "op": "equals",
      "value": 0,
      "label": "测试失败数=0"
    },
    {
      "type": "json_field",
      "path": "{bugs}",
      "field": "open_count",
      "op": "equals",
      "value": 0,
      "label": "Bug 全部闭环（bug 清单需含 open_count 汇总字段，缺失/非 0 即判 B——倒逼清单契约补齐）"
    }
  ]
}
