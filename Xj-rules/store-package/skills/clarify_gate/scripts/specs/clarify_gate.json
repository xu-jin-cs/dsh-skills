      "pattern": "组件范围",
      "path": "{block}",
      "op": "min",
      "value": 1,
      "label": "五要素2：组件范围（状态+证据引文）"
    },
    {
      "type": "grep_count",
      "pattern": "设计约束",
      "path": "{block}",
      "op": "min",
      "value": 1,
      "label": "五要素3：设计约束（状态+证据引文）"
    },
    {
      "type": "grep_count",
      "pattern": "验收标准",
      "path": "{block}",
      "op": "min",
      "value": 1,
      "label": "五要素4：验收标准（状态+证据引文）"
    },
    {
      "type": "grep_count",
      "pattern": "参考来源",
      "path": "{block}",
      "op": "min",
      "value": 1,
      "label": "五要素5：参考来源（状态+证据引文）"
